# 海报工作台 V2 · 本机配置
# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交；不要把真实 Key 写进 .env.example。
# 改完后刷新浏览器即可生效；只有 PORT 需要重启「启动.bat」。
# 留空的项使用页面默认值；填了的项会覆盖浏览器里记住的设置。

# 阿里云百炼 API Key：千问生图 + AI 识别填入
QWEN_API_KEY=

# 蚂蚁数科 MaaS API Key：拆层（生图接口选 MaaS 时也用它）
MAAS_API_KEY=

# 生图接口：qwen 或 maas
GEN_PROVIDER=qwen

# 千问生图模型（qwen-image-2.1 系列最多参考 10 张讲师肖像，其余 3 张）
QWEN_IMAGE_MODEL=qwen-image-3.0-pro

# 千问文本模型，用于 AI 识别填入（需支持结构化输出，如 qwen-plus、qwen-flash）
QWEN_TEXT_MODEL=qwen-plus

# 百炼地址；使用业务空间专属域名时改成 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 本地服务端口（改后需重启）
PORT=8765
